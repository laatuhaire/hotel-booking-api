# -------------------------- API environment -----------------------------------

NODE_ENV=development

# Port where the Express API will run
API_PORT=7799

# -------------------------- ORM environment -----------------------------------

# Database dialect (used by Sequelize)
DIALECT=postgres

# ------------------------ Development Database --------------------------------

# Development database user, created by the PostgreSQL container on first start
DEV_DB_USER=developer
DEV_DB_PASSWORD=9ec2a3d32b383c54ad4126b54d470fdf36fa0f843bca0b90703e6ca598462d4c

# Development database name
DEV_DB_NAME=hotel_booking_db_dev

# Development database connection host/port
DEV_DB_HOST=127.0.0.1
DEV_DB_PORT=5533

# Port PostgreSQL listens on inside the container
DEV_DB_CONTAINER_PORT=5533

# --------------------------- Test Database ------------------------------------

# Test database user, created by the PostgreSQL container on first start
TEST_DB_USER=tester
TEST_DB_PASSWORD=0d6b9209fe3bff6cc19455c2699454c286333d67fd7fcf455b2402b97f6971cc

# Test database name
TEST_DB_NAME=hotel_booking_db_test

# Test database connection host/port
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5511

# Port PostgreSQL listens on inside the container
TEST_DB_CONTAINER_PORT=5511

# ------------------------- Production Database --------------------------------

# Production database user, created by the PostgreSQL container on first start
PROD_DB_USER=production
PROD_DB_PASSWORD=d47ac305ae7593831b5fea899e6037907161a5c29d1ed4710a0219ba229f9a95

# Production database name
PROD_DB_NAME=hotel_booking_db_prod

# Production database connection host/port
PROD_DB_HOST=127.0.0.1
PROD_DB_PORT=5522

# Port PostgreSQL listens on inside the container
PROD_DB_CONTAINER_PORT=5522

# ------------------------------ PgAdmin ---------------------------------------

# PgAdmin credentials
PGADMIN_EMAIL=developer@api.com
PGADMIN_PASSWORD=b2c439621b604ab4e2dafe8d34b648d9e56116beaa2309d0a94d12f02297b258

# Host port (open http://localhost:5050) and port pgAdmin listens on inside the container
PGADMIN_PORT=5050
PGADMIN_CONTAINER_PORT=80

# ---------------------------- API secrets -------------------------------------

# API key for endpoints requests
API_KEY=2e9bc6c94a4cbdfe2a31d2df79103a5eb3702eaf5d7018d47a774e9540a8ec29

# Secret key to hash the JWT tokens
AUTH_API_JWT_SECRET_KEY=2e2ecbce601e7231740f546c38c3e23ebc3e91822ebb6d7633c72ad263b8e3bb

# Message body encryption secret
MESSAGE_ENCRYPTION_KEY=8f3c2a7d9e1b6f405c8a2d7e3f916b04a6d2c8e5f1b7390d4e7a6c2f8b5d1039

# ---------------------------- Front-end APP -----------------------------------

# Front-end application URL allowed by CORS
CORS_ORIGIN=http://localhost:3355

# Proxy hops in front of the API
TRUST_PROXY_HOPS=0
