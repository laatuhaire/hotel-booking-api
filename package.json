{
  "name": "hotel-booking-api",
  "version": "1.0.0",
  "description": "Secure role-based Hotel Booking API",
  "homepage": "https://github.com/laatuhaire/hotel-booking-api#readme",
  "bugs": {
    "url": "https://github.com/laatuhaire/hotel-booking-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laatuhaire/hotel-booking-api.git"
  },
  "license": "MIT",
  "author": "Lucky",
  "type": "module",
  "main": "src/api.js",
  "scripts": {
    "start": "node src/api.js",
    "dev": "nodemon src/api.js",
    "dev-dep": "npm install && npm install nodemon morgan eslint eslint-config-prettier eslint-plugin-prettier prettier --save-dev -D",
    "env-var": "cp .env/.envexample ./.env && echo \"Environment variables injected\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "migrations:generate": "sequelize-cli migration:generate --options-path .sequelizerc.cjs --name",
    "migrations:run": "sequelize-cli db:migrate --options-path .sequelizerc.cjs",
    "migrations:revert": "sequelize-cli db:migrate:undo --options-path .sequelizerc.cjs",
    "migrations:delete": "sequelize-cli db:migrate:undo:all --options-path .sequelizerc.cjs",
    "seed:generate": "sequelize-cli seed:generate --options-path .sequelizerc.cjs --name",
    "seed:run": "sequelize-cli db:seed:all --options-path .sequelizerc.cjs",
    "seed:revert": "sequelize-cli db:seed:undo --options-path .sequelizerc.cjs",
    "seed:delete": "sequelize-cli db:seed:undo:all --options-path .sequelizerc.cjs"
  },
  "keywords": [
    "JWT",
    "Express.js",
    "Socket.io",
    "PostgreSQL"
  ],
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-tools/load-files": "^8.0.6",
    "@graphql-tools/merge": "^10.0.6",
    "@hapi/boom": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "graphql": "^16.14.2",
    "graphql-scalars": "^2.0.1",
    "joi": "^18.3.0",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "react-router-dom": "^7.18.5",
    "sequelize": "^6.37.0",
    "sequelize-cli": "^6.6.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "eslint": "^8.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "morgan": "^1.12.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "vitest": "^5.1.0"
  }
}